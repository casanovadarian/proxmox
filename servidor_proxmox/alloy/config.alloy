// --- 1. BUSCADOR DE ARCHIVOS ---
local.file_match "pve_files" {
    path_targets = [
        {
            "job"      = "pve-tasks",
            "node"     = "pm-132",
            "__path__" = "/var/log/pve/tasks/*/UPID*",
        },
    ]
}

// --- 2. FUENTE DE LOGS ---
loki.source.file "pve_source" {
    targets    = local.file_match.pve_files.targets
    forward_to = [loki.process.pve_parser.receiver]
}

// --- 3. PROCESADOR (REGEX) ---
loki.process "pve_parser" {
    forward_to = [loki.write.loki_server.receiver]

    stage.regex {
        source     = "filename"
        expression = "UPID:[^:]+:[^:]+:[^:]+:[^:]+:(?P<pve_action>[^:]*):(?P<vmid>[^:]*):(?P<pve_user>[^:!]+)(?:!(?P<pve_source>[^:]+))?:"
    }

    stage.labels {
        values = {
            pve_action = "",
            vmid       = "",
            pve_user   = "",
            pve_source = "",
        }
    }
}

// --- 4. SISTEMA (JOURNAL) ---
loki.source.journal "system_journal" {
    forward_to = [loki.relabel.journal_labels.receiver]}

// 4.1. Configuración de etiquetas (Relabeling)
loki.relabel "journal_labels" {
  forward_to = [loki.write.loki_server.receiver]

// Define las etiquetas estáticas que tenías en Promtail
  rule {
    target_label = "job"
    replacement  = "system-journal"
  }
  rule {
    target_label = "node"
    replacement  = "pm-132"
  }
    rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.process "pve_auth_parser" {
    forward_to = [loki.write.loki_server.receiver]

    // Buscamos el patrón rhost= despues de authentication failure
    stage.regex {
        source     = "message"
        expression = "rhost=(::ffff:)?(?P<remote_ip>[0-9a-fA-F:.]+)"
    }

    // Extraemos el usuario también, ya que lo tienes en el log
    stage.regex {
        source     = "message"
        expression = "user=(?P<target_user>[^ ]+)"
    }

    stage.labels {
        values = {
            remote_ip   = "",
            target_user = "",
        }
    }
}


// --- 5. DESTINO (TU IP .235) ---
loki.write "loki_server" {
    endpoint {
        url = "http://10.12.112.235:3100/loki/api/v1/push"
    }
}